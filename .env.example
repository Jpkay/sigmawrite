# Supabase — get these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client (PRD §14).
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — leave blank to use the mock AI provider (PRD §17)
OPENAI_API_KEY=
# Set to "mock" (default when no key) or "openai"
AI_PROVIDER=mock

# Observability / analytics (optional in Phase 0)
NEXT_PUBLIC_POSTHOG_KEY=
ANALYTICS_ID_SALT=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=

# Production AI provider (mock is rejected by launch:verify-env)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2

# Browser/server telemetry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
POSTHOG_KEY=

# Email, jobs and operator alerts
RESEND_API_KEY=
EMAIL_FROM=
OPS_ALERT_EMAIL=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Protected deployment promotion (CI environment secrets)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT=
NEXT_PUBLIC_DATA_REGION=
NEXT_PUBLIC_AI_PROCESSORS=
LANGUAGETOOL_URL=
