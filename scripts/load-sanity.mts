import{config as loadEnv}from"dotenv";import{createClient}from"@supabase/supabase-js";loadEnv({path:".env.local",quiet:true});const url=process.env.NEXT_PUBLIC_SUPABASE_URL;const key=process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;const email=process.env.LOAD_TEST_STUDENT_EMAIL??"demo.eleve@reading-to-learn.test";const password=process.env.LOAD_TEST_STUDENT_PASSWORD??"Demo-2026-Strong!";if(!url||!key)throw new Error("Supabase public environment required");const db=createClient(url,key,{auth:{persistSession:false}});const auth=await db.auth.signInWithPassword({email,password});if(auth.error)throw auth.error;const runs=await Promise.all(Array.from({length:50},async()=>{const started=performance.now();const[{data:students,error:studentError},{data:texts,error:textError}]=await Promise.all([db.from("students").select("id"),db.from("text_versions").select("id").in("review_status",["human_approved","benchmark_locked"]).limit(5)]);if(studentError||textError)throw new Error(studentError?.message??textError?.message);if((students??[]).length!==1)throw new Error("RLS scope failure: expected exactly the signed-in student");return{latency:performance.now()-started,texts:texts?.length??0};}));const latencies=runs.map(run=>run.latency).sort((a,b)=>a-b);console.log(JSON.stringify({ok:true,concurrency:50,p50Ms:Math.round(latencies[24]),p95Ms:Math.round(latencies[47]),maxMs:Math.round(latencies[49]),approvedVisible:Math.max(...runs.map(run=>run.texts))}));
