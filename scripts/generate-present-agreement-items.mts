import{existsSync,mkdirSync,readFileSync,writeFileSync}from"node:fs";import{config as loadEnv}from"dotenv";loadEnv({path:".env.local",quiet:true});if(process.env.OPENROUTER_API_KEY){process.env.LLM_BASE_URL="https://openrouter.ai/api/v1";process.env.LLM_API_KEY=process.env.OPENROUTER_API_KEY;process.env.LLM_MODEL=process.env.OPENROUTER_MODEL??"z-ai/glm-5.2";}if(!process.env.LLM_MIN_INTERVAL_MS)process.env.LLM_MIN_INTERVAL_MS="3500";
import{PRESENT_AGREEMENT_MISCONCEPTIONS as MISCONCEPTIONS,PRESENT_AGREEMENT_NODES as NODES}from"@/lib/content/slices/present-agreement";import{getItemGenerator}from"@/lib/ai/item-generation/generator";import{runItemGenerationPipeline,yieldReport}from"@/lib/ai/item-generation/pipeline";import type{GateResults,GeneratedItem,ItemGenSpec,ItemGenerationResult}from"@/lib/ai/item-generation/schemas";
type Stored=GeneratedItem&{qcGates?:GateResults;reviewStatus?:GateResults["verdict"]};const count=Number(process.argv[2]??8);const only=process.argv[3];const nodes=NODES.filter(node=>!only||node.key===only);const knownNodeKeys=new Set(NODES.map(node=>node.key));const knownMisconceptionKeys=new Set(MISCONCEPTIONS.map(item=>item.key));const modality=(strand:string):ItemGenSpec["modality"]=>strand==="expression_ecrite"?"writing":strand==="comprehension_ecrite"?"reading":"grammar_analysis";const all:ItemGenerationResult[]=[];const keep:Stored[]=[];
console.log(`Generating ${count} item(s) for ${nodes.length} present/agreement node(s)…`);for(const node of nodes){try{const results=await runItemGenerationPipeline({nodeKey:node.key,strand:node.strand,labelFr:node.labelFr,cefrLevel:node.cefrMin,modality:modality(node.strand),learnerMode:"shared",count,misconceptionKeys:MISCONCEPTIONS.filter(m=>m.primaryNodeKey===node.key).map(m=>m.key)},{generator:getItemGenerator(),knownNodeKeys,knownMisconceptionKeys,ensembleThreshold:0.7});all.push(...results);for(const result of results)if(result.item&&result.gates.verdict!=="rejected")keep.push({...result.item,qcGates:result.gates,reviewStatus:result.gates.verdict});const report=yieldReport(results);console.log(`${node.key}: usable ${report.usable}/${report.total}`);}catch(error){console.log(`${node.key}: ERROR ${(error as Error).message}`);}await new Promise(resolve=>setTimeout(resolve,1000));}
mkdirSync("generated",{recursive:true});const path="generated/present-agreement-items.json";let bank:Stored[]=existsSync(path)?JSON.parse(readFileSync(path,"utf8")):[];const seen=new Set(bank.map(item=>`${item.nodeKey}|${item.promptFr}`));for(const item of keep){const key=`${item.nodeKey}|${item.promptFr}`;if(!seen.has(key)){bank.push(item);seen.add(key);}}writeFileSync(path,JSON.stringify(bank,null,2));const report=yieldReport(all);console.log(JSON.stringify({bank:bank.length,report},null,2));
if(process.env.NEXT_PUBLIC_SUPABASE_URL&&process.env.SUPABASE_SERVICE_ROLE_KEY){const{createClient}=await import("@supabase/supabase-js");const db=createClient(process.env.NEXT_PUBLIC_SUPABASE_URL,process.env.SUPABASE_SERVICE_ROLE_KEY,{auth:{persistSession:false}});const{error}=await db.from("generation_runs").insert({slice_key:"present_agreement",provider:process.env.AI_PROVIDER??"glm",model_id:process.env.LLM_MODEL??"z-ai/glm-5.2",prompt_version:"item-generation-v1",requested_count:count*nodes.length,generated_count:report.usable,yield_report:report,estimated_cost_usd:report.total*0.002,completed_at:new Date().toISOString()});if(error)throw new Error(error.message);}
