import{createClient}from"@supabase/supabase-js";import{assessLaunchContent,type LaunchContentCounts}from"../src/lib/launch/content-readiness";const url=process.env.NEXT_PUBLIC_SUPABASE_URL;const key=process.env.SUPABASE_SERVICE_ROLE_KEY;if(!url||!key)throw new Error("NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are required.");const db=createClient(url,key,{auth:{persistSession:false,autoRefreshToken:false}});async function count(table:string,apply?:(query:any)=>any){let query=db.from(table).select("*",{count:"exact",head:true});if(apply)query=apply(query);const{count,error}=await query;if(error)throw new Error(`${table}: ${error.message}`);return count??0;}const{data:lexicalRelease,error:lexicalReleaseError}=await db.from("lexical_releases").select("validation_report,source_attributions").eq("status","published").order("published_at",{ascending:false}).limit(1).maybeSingle();if(lexicalReleaseError)throw new Error(lexicalReleaseError.message);const lexicalReport=(lexicalRelease?.validation_report as{report?:{heldOutCoverage?:number}}|null)?.report;const lexicalSources=Array.isArray(lexicalRelease?.source_attributions)?lexicalRelease.source_attributions:[];
const counts:LaunchContentCounts={activeReviewers:await count("content_reviewer_profiles",q=>q.eq("active",true).eq("invite_status","active")),publishedPassages:await count("text_versions",q=>q.in("review_status",["human_approved","benchmark_locked"])),publishedReviewVersions:await count("content_review_versions",q=>q.eq("workflow_status","published")),submittedAssignments:await count("review_assignments",q=>q.eq("status","submitted")),lockedBenchmarks:await count("content_benchmarks",q=>q.eq("locked",true)),publishedDiagnosticBanks:await count("diagnostic_item_bank_releases",q=>q.eq("status","published")),publishedTaxonomyReleases:await count("taxonomy_releases",q=>q.eq("status","published")),publishedLexicalReleases:await count("lexical_releases",q=>q.eq("status","published")),lexicalLemmaCount:await count("lexical_lemmas"),lexicalHeldOutCoverage:Number(lexicalReport?.heldOutCoverage??0),lexicalSourceCount:lexicalSources.length};const result=assessLaunchContent(counts);console.log(JSON.stringify(result,null,2));if(!result.ready)process.exitCode=1;
