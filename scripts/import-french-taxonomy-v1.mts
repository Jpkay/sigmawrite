const releaseGate=await db.from("taxonomy_releases").select("id,status,manifest_checksum").eq("release_key",artifact.release.key).maybeSingle();fail(releaseGate.error?.message);if(releaseGate.data&&releaseGate.data.manifest_checksum!==artifact.manifest.contentChecksum)throw new Error("Existing release key has a different checksum.");if(releaseGate.data&&["published","withdrawn"].includes(releaseGate.data.status as string)){process.stdout.write(`${JSON.stringify({ok:true,unchanged:true,releaseId:releaseGate.data.id,checksum:artifact.manifest.contentChecksum})}\n`);process.exit(0);}
let ontology=await db.from("ontology_versions").select("id,checksum").eq("version",artifact.ontology.version).maybeSingle();fail(ontology.error?.message);if(ontology.data&&ontology.data.checksum!==artifact.ontology.checksum)throw new Error("Ontology version checksum mismatch.");if(!ontology.data){const r=await db.from("ontology_versions").insert({version:artifact.ontology.version,document_path:artifact.ontology.document,checksum:artifact.ontology.checksum,status:"active",approved_at:new Date().toISOString()}).select("id,checksum").single();fail(r.error?.message);ontology=r;}const ontologyId=ontology.data!.id as string;
let source=await db.from("taxonomy_sources").select("id").eq("source_key","sigma-original-taxonomy").maybeSingle();fail(source.error?.message);if(!source.data){const r=await db.from("taxonomy_sources").insert({source_key:"sigma-original-taxonomy",title:"SigmaWrite French Taxonomy",owner_name:"SigmaWrite",source_kind:"original",steward:"taxonomy-steward"}).select("id").single();fail(r.error?.message);source=r;}const sourceId=source.data!.id as string;
let sourceVersion=await db.from("taxonomy_source_versions").select("id,artifact_checksum").eq("source_id",sourceId).eq("version_label","1.0.0").maybeSingle();fail(sourceVersion.error?.message);if(sourceVersion.data&&sourceVersion.data.artifact_checksum!==artifact.sources.checksum)throw new Error("Taxonomy source checksum mismatch.");if(!sourceVersion.data){const r=await db.from("taxonomy_source_versions").insert({source_id:sourceId,version_label:"1.0.0",artifact_checksum:artifact.sources.checksum,rights_status:"importable",license_identifier:"Proprietary-SigmaWrite-v1",terms_snapshot:"Original SigmaWrite taxonomy records.",permitted_fields:["competency_nodes","competency_edges","mastery_evidence","progression_mappings","content_concepts"],attribution_template:"© SigmaWrite, French Taxonomy {release_version}.",commercial_use_allowed:true,decision_notes:"Original records approved by source register.",approved_at:new Date().toISOString()}).select("id,artifact_checksum").single();fail(r.error?.message);sourceVersion=r;}const sourceVersionId=sourceVersion.data!.id as string;
