let release=await db.from("taxonomy_releases").select("id,status,manifest_checksum").eq("release_key",artifact.release.key).maybeSingle();fail(release.error?.message);if(release.data&&release.data.manifest_checksum!==artifact.manifest.contentChecksum)throw new Error("Existing release key has a different checksum.");if(!release.data){const r=await db.from("taxonomy_releases").insert({release_key:artifact.release.key,version:artifact.release.version,ontology_version_id:ontologyId,status:"validating",manifest:{coverage:artifact.coverage,components:artifact.manifest.componentChecksums,gaps:artifact.gaps},manifest_checksum:artifact.manifest.contentChecksum,validation_report:{valid:true,issues:artifact.validation.issues}}).select("id,status,manifest_checksum").single();fail(r.error?.message);release=r;}const releaseId=release.data!.id as string;
if(!["published","withdrawn"].includes(release.data!.status as string)){
  const membership=async(recordType:string,recordId:string,stableKey:string,snapshot:unknown,recordChecksum:string)=>{const r=await db.from("taxonomy_release_memberships").upsert({release_id:releaseId,record_type:recordType,record_id:recordId,stable_key:stableKey,record_version:1,record_snapshot:snapshot,record_checksum:recordChecksum},{onConflict:"release_id,record_type,record_id"});fail(r.error?.message);};
  for(const node of artifact.taxonomy.nodes){await membership("competency_node",nodeIds.get(node.key)!,node.key,node,artifact.validation.manifest.checksums.nodes);
    for(const evidence of node.evidence){await membership("mastery_evidence",stableUuid("sigmawrite-mastery-evidence",`${node.key}:${evidence.key}`),`${node.key}:${evidence.key}`,evidence,artifact.validation.manifest.checksums.nodes);}
    for(const mapping of node.mappings){const expectation=node.evidence[0]?.expectation??"receptive";await membership("progression_mapping",stableUuid("sigmawrite-progression-mapping",`${node.key}:${mapping.learnerMode}:${mapping.framework}:${expectation}`),`${node.key}:${mapping.learnerMode}:${mapping.framework}:${expectation}`,mapping,artifact.validation.manifest.checksums.nodes);}}
  for(const edge of artifact.taxonomy.edges){await membership("competency_edge",stableUuid("sigmawrite-taxonomy-edge",`${edge.source}:${edge.target}:${edge.type}`),`${edge.source}:${edge.target}:${edge.type}`,edge,artifact.validation.manifest.checksums.edges);}
  for(const concept of artifact.contentConcepts){await membership("content_concept",stableUuid("sigmawrite-content-concept",concept.key),concept.key,concept,artifact.manifest.componentChecksums.concepts);}
}
const publisher=process.env.TAXONOMY_PUBLISHER_PROFILE_ID;if(publisher&&release.data!.status!=="published"){const reviewPath=artifact.release.key==="french-taxonomy-v1"?"docs/french-taxonomy-v1-release.md":"docs/french-taxonomy-v2-release.md";const review=readFileSync(reviewPath,"utf8");if(!review.includes(`**Approved checksum:** \`${artifact.manifest.contentChecksum}\``)||!review.includes("**Decision:** approve"))throw new Error("Checksum-bound release approval is not recorded.");const r=await db.from("taxonomy_releases").update({status:"published",published_by:publisher,published_at:new Date().toISOString()}).eq("id",releaseId).eq("status","validating");fail(r.error?.message);}
process.stdout.write(`${JSON.stringify({ok:true,releaseId,checksum:artifact.manifest.contentChecksum,published:Boolean(publisher),nodes:artifact.coverage.nodes})}\n`);
