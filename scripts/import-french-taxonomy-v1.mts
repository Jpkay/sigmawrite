if(!artifact.validation.valid)throw new Error("Taxonomy artifact is not valid.");
const url=process.env.NEXT_PUBLIC_SUPABASE_URL,key=process.env.SUPABASE_SERVICE_ROLE_KEY;if(!url||!key)throw new Error("Supabase service environment is required.");
