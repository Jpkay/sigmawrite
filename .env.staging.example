# Copy to .env.staging and fill from the dedicated staging project.
# The demo seeder checks that this ref matches the URL before writing.
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this value to browser code or NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override only when rotating all demo-account passwords.
DEMO_ACCOUNT_PASSWORD=Demo-2026-Strong!

# Keep staging integrations isolated from production.
AI_PROVIDER=glm
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2
EMBEDDING_MODEL=openai/text-embedding-3-small
NEXT_PUBLIC_POSTHOG_KEY=
ANALYTICS_ID_SALT=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
RESEND_API_KEY=
EMAIL_FROM=
OPS_ALERT_EMAIL=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=https://YOUR_STAGING_HOST
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT=
NEXT_PUBLIC_DATA_REGION=
NEXT_PUBLIC_AI_PROCESSORS=
LANGUAGETOOL_URL=
