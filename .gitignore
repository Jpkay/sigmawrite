# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.staging.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keep approved item banks reproducible; ignore transient generation reports.
generated/*
!generated/past-narration-items.json
!generated/present-agreement-items.json
!generated/french-baseline-lexicon.json
!generated/french-taxonomy-v1.json
!generated/french-taxonomy-v2.json
!generated/diagnostic-bank-v2.json
!generated/dictations-v1.json

# Supabase CLI local state
/supabase/.branches/
/supabase/.temp/
