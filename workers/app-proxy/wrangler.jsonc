{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plume-app-proxy",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "app.trouvetaplume.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
